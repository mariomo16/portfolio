---
import angularSvg from "../assets/angular.svg";
import flutterSvg from "../assets/flutter.svg";
import javascriptSvg from "../assets/javascript.svg";
import laravelSvg from "../assets/laravel.svg";
import phpSvg from "../assets/php.svg";
import typescriptSvg from "../assets/typescript.svg";
import { useTranslations } from "../i18n/utils";

const { t } = useTranslations(Astro.currentLocale || "es");

const techs = [
  { name: "Angular", color: "#DD0031", svg: angularSvg },
  { name: "TypeScript", color: "#3178C6", svg: typescriptSvg },
  { name: "JavaScript", color: "#F7DF1E", svg: javascriptSvg },
  { name: "PHP", color: "#777BB4", svg: phpSvg },
  { name: "Laravel", color: "#FF2D20", svg: laravelSvg },
  { name: "Flutter", color: "#02569B", svg: flutterSvg },
];
---

<section class="about" id="about">
  <div class="container">
    <h2 class="section-title">{t("about.title")}</h2>
    <div class="about-content">
      <div class="bio">
        <p>{t("about.bio")}</p>
      </div>
      <div class="tech-grid">
        {
          techs.map((tech) => (
            <div class="tech-card" style={`--tech-color: ${tech.color}`}>
              <img src={tech.svg.src} alt={tech.name} class="tech-icon" />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .about-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: start;
  }

  .bio p {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    line-height: 1.8;
  }

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .tech-card {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px 12px;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition:
      border-color 0.2s,
      transform 0.2s;
  }

  .tech-card:hover {
    border-color: var(--tech-color, var(--accent));
    transform: translateY(-2px);
  }

  .tech-icon {
    width: 40px;
    height: 40px;
  }

  @media (max-width: 768px) {
    .about-content {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .tech-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 400px) {
    .tech-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
